
@rendermode InteractiveServer

@inject GetOrderDetailsHandler getOrderDetailsHandler
@inject DeleteOrderHandler deleteOrderHandler

@if (_isLoading)
{
    <p>Loading Details.......</p>
}
else
{
    if (_orderDetails is null)
    {
        <p>No order found.
            @_responseMessage
        </p>
    }
    else
    {
        <div class="order-container">

            <!-- Order Header -->
            <div class="order-header">

                <h2>Order #@_orderDetails.OrderNumber</h2>
                    

                <div class="order-header-sub">
                    <span class="order-date">
                        @_orderDetails.CreatedDate.ToString("dd MMMM yyyy")
                    </span>

                    
                    <span class="order-status @_orderDetails.OrderStatus.ToLower()">
                        @_orderDetails.OrderStatus
                    </span>
                </div>


            </div>


            <!-- Order Information -->
            <div class="order-info">

                <div class="info-box">
                    <span class="info-title">Created By</span>
                    <span class="info-value">@_orderDetails.CreatedBy</span>
                </div>

                <div class="info-box">
                    <span class="info-title">Delivery Address</span>
                    <span class="info-value">@_orderDetails.DeliveryAddress</span>
                </div>

                <div class="info-box">
                    <span class="info-title">Items</span>
                    <span class="info-value">@_orderDetails.OrderLineItems.Count</span>
                </div>

                <div class="info-box">
                    <span class="info-title">Confirmation</span>

                    <span class="info-value confirm-badge @(_orderDetails.IsConfirmed ? "confirmed" : "not-confirmed")">
                        @(_orderDetails.IsConfirmed ? "Confirmed" : "Awaiting Confirmation")
                    </span>

                </div>

            </div>


            <!-- Product List -->
            <div class="order-products">

                <h3>Ordered Products</h3>

                @foreach (var item in _orderDetails.OrderLineItems)
                {
                    <div class="product-card">

                        <div class="product-details">
                            <span class="product-name">@item.ProductName</span>
                            <span class="product-qty">Quantity: @item.OrderCount</span>
                        </div>

                        <span class="product-status @(item.IsActive ? "active" : "inactive")">
                            @(item.IsActive ? "Active" : "Removed")
                        </span>

                    </div>
                }

            </div>

            @if(_cancelOrderResponseMessage is not null)
            {
                <Status SuccessStatus="@_isSuccessful" StatusMessage="@_cancelOrderResponseMessage" />
            }

            <!-- Order Actions -->
            @if (ShowActionButtons)
            {
                <div class="order-actions">

                    <button class="btn cancel" disabled="@_isCancelling" @onclick="(() => OnHandleClose(_isSuccessful))">Close</button>

                    <button class="btn cancel-btn" disabled="@_isSuccessful" @onclick="CancelOrder" >
                        @(_isCancelling ? "Cancelling Order....." : "Cancel Order")
                    </button>
                    

                </div>
            }


        </div>
    }
}



@code {

    private bool _isLoading;
    private OrderDetailsDto? _orderDetails;
    private string _responseMessage;

    private bool _isSuccessful;
    private bool _isCancelling;
    private string _cancelOrderResponseMessage;

    [Parameter, EditorRequired]
    public OrderDto OrderToView { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<bool> HandleClose { get; set; }

    [Parameter]
    public bool ShowActionButtons { get; set; } = false;

    protected override async Task OnParametersSetAsync()
    {

        if(_orderDetails is null)
        {
            _isLoading = true;

            await Task.Delay(250);

            if (OrderToView is not null)
            {
                var result = await getOrderDetailsHandler.Handle(OrderToView.Id);
                _orderDetails = result.orderDetails; _responseMessage = result.responseMessage;
            }
            else
            {
                _responseMessage = "No Order Selected.";
            }

            _isLoading = false;
        }

    }

    private async Task OnHandleClose(bool refreshDecision = false)
    {
        _orderDetails = null;
        _responseMessage = null;
        await HandleClose.InvokeAsync(refreshDecision);
    }


    private async Task CancelOrder()
    {
        _isCancelling = true;_cancelOrderResponseMessage = null;

        // await Task.Delay(5000);
        // _isSuccessful = DateTime.Now.Second % 2 == 0;
        // _cancelOrderResponseMessage = _isSuccessful ? "Order Cancelled Successfully" : "Order Cancel Failed";

        var result = await deleteOrderHandler.Handle(_orderDetails.Id);
        _isSuccessful = result.isSuccessful; _cancelOrderResponseMessage = result.responseMessage;

        _isCancelling = false;
    }

}
