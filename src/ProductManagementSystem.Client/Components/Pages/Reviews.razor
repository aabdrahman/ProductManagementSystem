
@inject GetReviewsHandler getReviewsHandler

@rendermode InteractiveServer

@if(_reviews is not null)
{

    <section id="reviews" class="reviews">

        <div class="reviews-header">
            <h2>What Our Customers Say</h2>
            <p>
                Real feedback from users who trust our products.
            </p>
        </div>

        @if (_reviews.Any())
        {

            <div class="reviews-grid">

                @foreach (var review in _reviews)
                {
                    <div class="review-card">
                        <p class="review-text">"@review.ReviewText"</p>
                        <p class="review-author">– @review.ReviewerName</p>
                        <p class="review-rating">
                            @for (int i = 0; i < review.Rating; i++)
                            {
                                <span>★</span>
                            }
                            @for (int i = review.Rating; i < 5; i++)
                            {
                                <span>☆</span>
                            }
                        </p>
                    </div>
                }

            </div>
        }
        else
        {
            <div class="no-reviews" id="noReviews">
                <h3>No reviews yet</h3>
                <p>
                    Be the first to share your experience with our products.
                    Your feedback helps others make better choices.
                </p>
                <a href="#add-review" class="add-review-btn">Write a Review</a>
            </div>
        }


    </section>
}


