{
    @* <Spinner Description="Loading Content Details" /> 
} *@
@if(_aboutUsItems is not null)
{
    <section class="about-us-content-management">

        <div class="management-header">
            <h3>
                Manage About Us Content
            </h3>

            <p>
                Manage About Us Content details seen by users
            </p>

            <button role="button" class="add-content-btn" @onclick="(async () => await HandleAddDetails.InvokeAsync())">
                ➕ Add New About Us Content
            </button>

        </div>

        @if (_aboutUsItems.Any())
        {
            <div class="management-table-wrapper">

                <table class="management-table">

                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Content Details</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach(var content in _aboutUsItems)
                        {
                            <tr>
                                <td>@content.title</td>
                                <td>@content.contentDetails</td>
                                <td class="actions">
                                    <button class="btn view" @onclick="(async () => await HandleViewDetails.InvokeAsync(content))">View</button>
                                    <button class="btn edit" @onclick="(async () => await HandleEditDetails.InvokeAsync(content))">Edit</button>
                                    <button class="btn delete" @onclick="(async () => await HandleDeleteDetails.InvokeAsync(content))">Delete</button>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="no-contents">
                <h3>No why choose us content available</h3>
                <p>
                    Start by adding your first why choose us content.
                    @_responseMessage
                </p>
            </div>
        }

    </section>
}



@code {

    private bool _isLoading;
    private string _responseMessage;

    private List<AboutUsDto> _aboutUsItems;

    [Parameter, EditorRequired]
    public IEnumerable<AboutUsDto> AboutUsItemsDetails { get; set; }

    [Parameter, EditorRequired]
    public string ResponseMessage { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<AboutUsDto> HandleViewDetails { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<AboutUsDto> HandleEditDetails { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<AboutUsDto> HandleDeleteDetails { get; set; }

    [Parameter, EditorRequired]
    public EventCallback HandleAddDetails { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;

        await Task.Delay(250);
        _aboutUsItems = AboutUsItemsDetails.ToList();

        _isLoading = false;
    }
}
