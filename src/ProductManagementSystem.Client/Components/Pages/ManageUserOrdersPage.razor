

@page "/orders"

@attribute [Authorize]

@rendermode InteractiveServer

@inject GetUserOrdersHandler getOrdersHandler

<section class="order-management">

    <div class="order-management-header">
        <h2>Order Management</h2>

        <p>Track, manage, and process customer orders.</p>

        <div></div>
    </div>

    @if (_isLoading)
    {
        <p>Loading orders...</p>
    }
    else
    {
        if (!_orders.Any())
        {
            <div class="no-orders">
                <h3>No orders yet</h3>
                <p>Orders placed by customers will appear here.</p>
            </div>
        }
        else
        {
            <OrdersListView Orders="_orders" HandleViewOrder="OnHandleView" HandleUpdateOrderStatus="OnHandleUpdateStatus" HandleCancelOrder="OnHandleCancelOrder" />

        }
    }
 

</section>


<Popup @ref="popup" Title="@_title" ShowCloseButton="@_showCloseButton" >
    <Body>
        @if(_operationToPerform == OperationType.ViewOrder)
        {
            <OrderDetail OrderToView="@_selectedOrder" HandleClose="HandleClose" />
        }
        else if(_operationToPerform == OperationType.UpdateOrderStatus)
        {
            <UpdateOrderStatusOperationView OrderToUpdate="_selectedOrder" HandleClose="HandleClose" />
        }
        else if(_operationToPerform == OperationType.CancelOrder)
        {
            <OrderDetail OrderToView="@_selectedOrder" ShowActionButtons="@true" HandleClose="HandleClose" />
        }
    </Body>
</Popup>


@code {

    private bool _isLoading;
    private IEnumerable<OrderDto> _orders;
    private string _responseMessage;

    private string _userEmailAddress;
    private int _loggedinUserId = 0;

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;

        var authState = await authStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        _userEmailAddress = user.FindFirst(x => x.Type.EndsWith("emailaddress"))?.Value ?? "0";
        var userId = user.FindFirst(x => x.Type.EndsWith("nameidentifier"))?.Value ?? "0";

        await Task.Delay(250);

        if(int.TryParse(userId, out _loggedinUserId))
        {
            var result = await getOrdersHandler.Handle(_loggedinUserId, _userEmailAddress);
            _orders = result.orders; _responseMessage = result.message;
        }

        _isLoading = false;
    }
}

@code{
    private string _title;
    private bool _showCloseButton = false;
    private OperationType _operationToPerform;
    private OrderDto _selectedOrder;
    private Popup popup;

    private async Task OnHandleView(OrderDto selectedOrder)
    {
        _selectedOrder = selectedOrder;
        _title = $"Order Details For {_selectedOrder.OrderNumber}";
        _operationToPerform = OperationType.ViewOrder;
        _showCloseButton = true;

        popup.OpenModal();
    }


    private async Task OnHandleUpdateStatus(OrderDto selectedOrder)
    {
        _selectedOrder = selectedOrder;
        _title = $"Update Status For {_selectedOrder.OrderNumber}";
        _operationToPerform = OperationType.UpdateOrderStatus;
        _showCloseButton = false;

        popup.OpenModal();
    }

    private async Task HandleClose(bool refreshDecision)
    {
        _showCloseButton = false;
        _selectedOrder = null;
        _title = null;
        _operationToPerform = default;

        if (refreshDecision)
        {
            var result = await getOrdersHandler.Handle(_loggedinUserId, _userEmailAddress);
            _orders = result.orders; _responseMessage = result.message;
        }

        popup.CloseModal();
    }

    private async Task OnHandleCancelOrder(OrderDto selectedOrder)
    {
        _selectedOrder = selectedOrder;
        _title = $"Cancel Order {_selectedOrder.OrderNumber}";
        _operationToPerform = OperationType.CancelOrder;
        _showCloseButton = true;

        popup.OpenModal();
    }

    enum OperationType
    {
        None,
        ViewOrder,
        UpdateOrderStatus,
        CancelOrder
    }
}
