
@inject VerifyOtpHandler verifyOtpHandler
@inject SendVerificationOtpHandler sendVerificationOtpHandler

@if(!_isLoading)
{
    <div class="otp-wrapper">
        <p class="otp-instruction">Enter the 6-digit code sent to your email</p>
    
        <div class="otp-input-group">
            @for (int i = 0; i < 6; i++)
            {
                int index = i;
                <input type="text"
                       maxlength="1"
                       class="otp-field"
                       @bind="otpValues[index]"
                       @oninput="(e) => HandleInput(e, index)"
                       @onkeydown="(e) => HandleKeyDown(e, index)"
                       @ref="inputRefs[index]" />
            }
        </div>

        @if(_verifyOtpResponseMessage is not null)
        {
            <Status SuccessStatus="@_verifyOtpSuccessStatus" StatusMessage="@_verifyOtpResponseMessage" />
        }

        @if(_resendOtpResponseMessage is not null)
        {
            <Status SuccessStatus="@_resendOtpSuccessStatus" StatusMessage="@_verifyOtpResponseMessage" />
        }

        <div class="otp-actions">
            <button class="btn-verify" @onclick="VerifyCode" disabled="@(IsIncomplete || isBusy)">
                @if (isBusy)
                {
                    <span class="spinner">Validating OTP.....</span>
                }
                else
                {

                    <span>Verify Code</span>
                }
            </button>
            <button class="btn-resend" @onclick="ResendCode" hidden="@_verifyOtpSuccessStatus" disabled="@resendDisabled">
                @(resendDisabled ? $"Resend in {timer}s" : "Resend Code")
            </button>
        </div>
    </div>
}

@code {
    private string[] otpValues = new string[6];
    private ElementReference[] inputRefs = new ElementReference[6];
    private bool isBusy = false;
    private bool resendDisabled = true;
    private int timer = 30;

    private string _verifyOtpResponseMessage;
    private string _resendOtpResponseMessage;
    private bool _verifyOtpSuccessStatus;
    private bool _resendOtpSuccessStatus;

    private bool IsIncomplete => otpValues.Any(string.IsNullOrEmpty);
    private bool _isLoading;

    private ValidateOtpRequestDto _validateOtpRequestModel;

    [Parameter, EditorRequired]
    public UserDto UserToVerify { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<bool> HandleClose { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        await Task.Delay(250);
        _isLoading = false;
    }

    protected override async Task OnInitializedAsync()
    {
        await StartCountdown();
    }

    private async Task StartCountdown()
    {
        resendDisabled = true;

        timer = 75;

        while (timer > 0)
        {
            await Task.Delay(1000);
            timer--;
            StateHasChanged();
        }
        resendDisabled = false;
    }

    // Logic to move focus to the next box automatically
    private async Task HandleInput(ChangeEventArgs e, int index)
    {
        var val = e.Value?.ToString();
        if (!string.IsNullOrEmpty(val) && index < 5)
        {
            await inputRefs[index + 1].FocusAsync();
        }
    }

    // Logic to handle backspace moving focus backward
    private async Task HandleKeyDown(KeyboardEventArgs e, int index)
    {
        if (e.Key == "Backspace" && string.IsNullOrEmpty(otpValues[index]) && index > 0)
        {
            await inputRefs[index - 1].FocusAsync();
        }
    }

    private async Task VerifyCode()
    {
        isBusy = true;
        var fullCode = string.Join("", otpValues);

        _validateOtpRequestModel = new ValidateOtpRequestDto()
        {
            OTP = fullCode,
            UserEmailAddress = UserToVerify.Email
        };

        await Task.Delay(3500);

        // Call your API logic here
        _verifyOtpSuccessStatus = DateTime.Now.Second % 2 == 0;
        _verifyOtpResponseMessage = _verifyOtpSuccessStatus ? "Verification Successful" : "Verification Failed.";

        var result = await verifyOtpHandler.Handle(_validateOtpRequestModel);

        _verifyOtpSuccessStatus = result.isSuccessful; _verifyOtpResponseMessage = result.responseMessage;

        Array.Clear(otpValues);

        if (_verifyOtpSuccessStatus)
        {
            isBusy = false;
            await Task.Delay(2000);
            await HandleClose.InvokeAsync(true);
        }

        isBusy = false;
    }

    private async Task ResendCode() // Implement resend logic
    {
        timer = 75;
        resendDisabled = true;_verifyOtpSuccessStatus = default;
        _verifyOtpResponseMessage = null;

        var result = await sendVerificationOtpHandler.Handle(new SendOtpRequestDto() { UserEmailAddress = UserToVerify.Email, UserId = UserToVerify.Id });
        _resendOtpSuccessStatus = result.isSuccessful; _resendOtpResponseMessage = result.responseMessage;

        if (_resendOtpSuccessStatus)
        {
            Array.Clear(otpValues);

            await StartCountdown();
        }
    } 
}