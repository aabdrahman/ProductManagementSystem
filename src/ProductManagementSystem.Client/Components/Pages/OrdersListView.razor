

@if(_orders is not null)
{
    <div class="management-table-wrapper">
        <table class="management-table">

            <thead>
                <tr>
                    <th>Created Date</th>
                    <th>Status</th>
                    <th>Order Tracking ID</th>
                    <th>Ordered By</th>
                    <th>Total Count</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var order in _orders)
                {
                    <tr>

                        <td>@order.CreatedDate.ToString("dd MMM yyyy")</td>
                        <td>
                            <span class="status-badge @order.OrderStatus.ToLower()">
                                @order.OrderStatus
                            </span>
                        </td>
                        <td>@order.OrderNumber</td>
                        <td>@order.CreatedBy</td>
                        <td>@order.LineItemsCount</td>
                        <td class="actions">

                             <button class="btn view"
                                    @onclick="(() => OnView(order))">
                                View
                            </button>
                           

                            @if (order.OrderStatus.ToString().Equals(OrderStatus.Pending.ToString(), StringComparison.CurrentCultureIgnoreCase) || order.OrderStatus.ToString().Equals(OrderStatus.Confirmed.ToString(), StringComparison.CurrentCultureIgnoreCase) || order.OrderStatus.ToString().Equals(OrderStatus.Processing.ToString(), StringComparison.CurrentCultureIgnoreCase))
                            {
                                <AuthorizeView>
                                    @if (context.User.IsInRole("ADMIN") || context.User.IsInRole("SYSTEM"))
                                    {
                                        <button class="btn complete"
                                                @onclick="() => OnHandleUpdateStatus(order)">
                                            Update Status
                                        </button>
                                    }
                                    
                                    <button class="btn cancel"
                                            @onclick="() => OnHandleCancelOrder(order)">
                                        Cancel
                                    </button>

                                </AuthorizeView>
                                
                            }


                        </td>

                    </tr>
                }

            </tbody>

        </table>
    </div>
    
}
else
{
    <p>Loading Orders......</p>
}




@code {

    private List<OrderDto> _orders;

    [Parameter, EditorRequired]
    public IEnumerable<OrderDto> Orders { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<OrderDto> HandleViewOrder { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<OrderDto> HandleUpdateOrderStatus { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<OrderDto> HandleCancelOrder { get; set; }


    protected override async Task OnParametersSetAsync()
    {
        await Task.Delay(250);
        _orders = Orders.ToList();
    }

    private async Task OnView(OrderDto selectedOrder)
    {
        await HandleViewOrder.InvokeAsync(selectedOrder);
    }

    private async Task OnHandleUpdateStatus(OrderDto selectedOrder)
    {
        await HandleUpdateOrderStatus.InvokeAsync(selectedOrder);
    }

    private async Task OnHandleCancelOrder(OrderDto selectedOrder)
    {
        await HandleCancelOrder.InvokeAsync(selectedOrder);
    }
}
