
@page "/login"
@using ProductManagementSystem.Client.AuthProviderUtility

@rendermode InteractiveServer

@inject LoginHandler loginHandler
@inject RequestContext requestContext

@layout ProductManagementSystem.Client.Components.Layout.CustomLayout

@if(_isProcessing)
{
    <Spinner Description="Processing...." />    
}

<div class="auth-page">

    <div class="auth-card">

        <h2>Login</h2>
        <p class="auth-subtitle">Access your account</p>

        @if(_loginUserModel is not null)
        {
            <EditForm Model="_loginUserModel" OnValidSubmit="LoginUser">

                <DataAnnotationsValidator />

                @if(_responseMessage is not null)
                {
                    <Status SuccessStatus="@_isSuccessful" StatusMessage="@_responseMessage" />
                }

                <div class="form-group">
                    <label>Email</label>
                    <InputText @bind-Value="_loginUserModel.Email" />
                    <ValidationMessage For="(() => _loginUserModel.Email)" />

                </div>

                <div class="form-group">
                    <label>Password</label>
                    <InputText type="password" @bind-Value="_loginUserModel.Password" />
                    <ValidationMessage For="(() => _loginUserModel.Password)" />
                </div>

                <button class="auth-btn" disabled="@(_isProcessing || _isSuccessful)">
                    @(_isProcessing ? "Login Processing....." : "Login")
                </button>

            </EditForm>
        }

        <div class="auth-footer">
            Don't have an account?
            <a href="/register-user">Register</a>
        </div>

    </div>

</div>

@code {

    private LoginUserDto _loginUserModel;

    private bool _isProcessing;
    private bool _isSuccessful;
    private string _responseMessage;

    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(200);
        requestContext.BaseUri = navigationManager.BaseUri;
        _loginUserModel = new LoginUserDto();
    }

    private async Task LoginUser()
    {
        _isProcessing = true;_responseMessage = null;

        // await Task.Delay(5000);

        // _isSuccessful = DateTime.Now.Second % 2 == 0;
        // _responseMessage = _isSuccessful ? "User Logged in successfully." : "User Login Failed.";

        // await JSRuntime.InvokeVoidAsync("alert", _responseMessage);

        var result = await loginHandler.Handle(_loginUserModel);
        _isSuccessful = result.isSuccessful;
        _responseMessage = result.message;

        if (_isSuccessful)
        {
            _ = Task.Run(async () =>
            {
                await Task.Delay(2500);
                navigationManager.NavigateTo("/", forceLoad: true);
            });
        }


        _isProcessing = false;
    }

}

