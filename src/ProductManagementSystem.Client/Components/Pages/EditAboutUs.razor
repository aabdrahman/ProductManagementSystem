
@inject UpdateAboutUsContentHandler updateAboutUsContentHandler

<section class="add-new-content-page">
    <div class="form-header">
        <h2>Add New Why Choose Us Content</h2>
        <p>Add Why Choose Us Content</p>
    </div>

    @if (_isSubmitting)
    {
        <Spinner Description="Adding Content Details" />
    }

    @if(_updateContentModel is not null)
    {
        <EditForm Model="_updateContentModel" OnValidSubmit="HandleEditContent">
            <DataAnnotationsValidator />

            @if(_responseMessage is not null)
            {
                <Status StatusMessage="@_responseMessage" SuccessStatus="_isSuccessful" />
            }

            <div class="form-grid">

                <div class="form-group">

                    <label>Title</label>
                    <InputText @bind-Value="_updateContentModel.Title" />
                    <ValidationMessage For="(() => _updateContentModel.Title)" />

                </div>

                <div class="form-group">

                    <label>Content Details</label>
                    <InputTextArea rows="3" @bind-Value="_updateContentModel.ContentDetails" />
                    <ValidationMessage For="(() => _updateContentModel.ContentDetails)" />

                </div>

            </div>

            <div class="form-actions">

                <button class="btn submit" disabled="@(_isSubmitting || _isSuccessful)" type="submit">
                    @(_isSubmitting ? "Saving Content Changes" : "Save Content Changes")
                </button>

                <button class="btn cancel" type="button" disabled="@_isSubmitting" @onclick="(async () => await HandleClose.InvokeAsync(_isSuccessful))">Cancel</button>

            </div>

        </EditForm>
    }

</section>

@code {

    private UpdateAboutUsDto _updateContentModel;
    private bool _isSubmitting;
    private bool _isSuccessful;
    private bool _isLoading;
    private string _responseMessage;

    [Parameter, EditorRequired]
    public EventCallback<bool> HandleClose { get; set; }

    [Parameter, EditorRequired]
    public AboutUsDto AboutUsContentToEdit { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        await Task.Delay(250);
        if(AboutUsContentToEdit is null)
        {
            return;
        }

        _updateContentModel = new UpdateAboutUsDto()
        {
            Id = AboutUsContentToEdit.Id,
            Title = AboutUsContentToEdit.title,
            ContentDetails = AboutUsContentToEdit.contentDetails
        };
    }

    private async Task HandleEditContent()
    {
        _isSubmitting = true;_responseMessage = null;

        // await Task.Delay(5000);

        // _isSuccessful = DateTime.Now.Second % 2 == 0;
        // _responseMessage = _isSuccessful ? "Content Added Successfully" : "Content could not be added";

        var result = await updateAboutUsContentHandler.Handle(_updateContentModel);
        _responseMessage = result.responseMessage; _isSuccessful = result.isSuccesful;
        
        _isSubmitting = false;

        if(_isSuccessful)
        {

            _ = Task.Run(async () =>
            {
                await Task.Delay(1500);

                _updateContentModel = new();

                // isSubmitting = false; _
                await Task.Delay(2500);

                await OnHandleClose(true);
            });
        }

    }

    private async Task OnHandleClose(bool refreshDecision = false)
    {

        _responseMessage = null; _updateContentModel = null;
        _isSubmitting = default; _isSuccessful = default;

        await HandleClose.InvokeAsync(refreshDecision);
    } 
}
