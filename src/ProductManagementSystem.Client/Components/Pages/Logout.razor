
@page "/logout"

@layout ProductManagementSystem.Client.Components.Layout.CustomLayout

@inject LogoutHandler logoutHandler

@if (_isLoading)
{
    <p>
        <Spinner Description="Logging Out" />
    </p>
}
else
{
    if(_responseMessage is not null)
    {
        <Popup Title="Logout Notification" ShowCloseButton="false" ShowFooter="false">
            <Body>
                <p class="validation-message">@_responseMessage</p>
            </Body>
        </Popup>
    }
}

@code {

    private bool _isLoading = false;
    private string _responseMessage;
    private bool _isSuccessfullyLoggedOut;

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;

        await Task.Delay(500);

        var isLogoutResult = await logoutHandler.Handle();
        _responseMessage = isLogoutResult.responseMessage;
        _isSuccessfullyLoggedOut = isLogoutResult.isSuccessful;

        if (isLogoutResult.isSuccessful)
        {
            await Task.Delay(3000);
            navigationManager.NavigateTo("/login");
        }
        else
        {
            await Task.Delay(3000);
            navigationManager.NavigateTo("/login");
        }
    }
}
