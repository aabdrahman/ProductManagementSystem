
@page "/forgot-password"

@inject ChangePasswordHandler changePasswordHandler
@inject RequestPasswordResetOtpHandler requestPasswordResetOtpHandler

<PageTitle>Forgot Password</PageTitle>

@layout CustomLayout

@if (_isSendingOTP)
{
    <Spinner Description="Validating Email" />
}

@if (_isLoading)
{
    <Spinner Description="Initializing Page...." />
}

@if (_isChangingPassword)
{
    <Spinner Description="Changing Password...." />
}

@if (!_isLoading)
{
    <div class="auth-container">
        <div class="auth-card">
            <h2>Forgot Password</h2>
            <p class="auth-subtext">
            
                @(_isSuccessfullyValidated ? "Enter your email address and we'll send you a link to reset your password." : "Please choose a strong new password.")
          
            </p>

            @if (!_isSuccessfullyValidated)
            {
                if (!string.IsNullOrEmpty(_responseMessage) && !_isOTPSent)
                {
                    <Status SuccessStatus="@_isOTPSent" StatusMessage="@_responseMessage" />
                }

                <div class="form-group">
                    <label>Email Address</label>
                    <input @bind="_emailAddress" @bind:event="oninput" type="email" placeholder="Enter your email" />
                    @if (string.IsNullOrEmpty(_emailAddress) && !_isSendingOTP)
                    {
                        <span class="validation-message">Email is required.</span>
                    }
            
                </div>

                <button disabled="@(_isSendingOTP)" class="auth-btn" @onclick="HandleSendOTP">Send Reset Link</button>

                <div class="auth-footer">
                    <a href="/login">Back to Login</a>
                </div>
            }
            else
            {
                @if (_changePasswordModel is not null)
                {
                    <EditForm Model="_changePasswordModel" FormName="ChangePasswordForm" OnValidSubmit="HandlePasswordChange">

                        <DataAnnotationsValidator />

                        @if(_changePasswordResponseMessage is not null)
                        {
                            <Status SuccessStatus="@_passwordChangeStatus" StatusMessage="@_changePasswordResponseMessage" />
                        }

                        <div class="form-group">
                            <label>New Password</label>
                            <InputText @bind-Value="_changePasswordModel.NewPassword" type="password" class="form-control" />
                            <ValidationMessage For="@(() => _changePasswordModel.NewPassword)" />
                        </div>

                        <div class="form-group">
                            <label>Confirm Password</label>
                            <InputText @bind-Value="_changePasswordModel.ConfirmPassword"  type="password" class="form-control" />
                            <ValidationMessage For="@(() => _changePasswordModel.ConfirmPassword)" />
                        </div>

                        <button type="submit" class="auth-btn">Reset Password</button>

                    </EditForm>
                }
            
            }

        </div>
    </div>



    <Popup @ref="popup" Title="Password Change Verification" ShowCloseButton="false">
        <Body>
            <PasswordResetOtpInput HandleClose="HandleClose" UserEmailAddress="@_emailAddress" />
        </Body>
    </Popup>
}



@code {

    private string _emailAddress = "";
    private bool _isSendingOTP = false;

    private bool _isOTPSent = false;
    private string _responseMessage;

    private ChangePasswordDto _changePasswordModel;
    private bool _isChangingPassword = false;
    private bool _passwordChangeStatus;
    private string _changePasswordResponseMessage;
    private bool _isValidatedFromPopup = false;

    private bool _isLoading = false;
    private bool _isSuccessfullyValidated = false;

    private Popup popup;

    override protected async Task OnInitializedAsync()
    {
        _isLoading = true;

        await Task.Delay(250);

        _isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var passwordResetToken = await localStorageUtility.GetItemFromStorageAsync<string>("password-reset-token");
            var userEmail = await localStorageUtility.GetItemFromStorageAsync<string>("password-reset-user");

            _isSuccessfullyValidated = !string.IsNullOrEmpty(passwordResetToken);

            if (_isSuccessfullyValidated)
            {
                _emailAddress = userEmail;
                _changePasswordModel = new ChangePasswordDto() { Email = userEmail };
            }

            _isLoading = false;
        }

        if (_isValidatedFromPopup)
        {
            _isLoading = true;
            await Task.Delay(250);
            var userEmail = await localStorageUtility.GetItemFromStorageAsync<string>("password-reset-user");
            _changePasswordModel = new ChangePasswordDto() { Email = userEmail };
            _isLoading = false; _isValidatedFromPopup = false;
        }
    }

    private async Task HandleSendOTP()
    {
        if (!string.IsNullOrEmpty(_emailAddress))
        {
            _isSendingOTP = true; _responseMessage = null;

            await Task.Delay(200);

            var result = await requestPasswordResetOtpHandler.Handle(_emailAddress);

            _isOTPSent = result.isSuccessful; _responseMessage = result.message;

            // _isOTPSent = DateTime.Now.Second % 2 == 0; Simulate success or failure
            // _responseMessage = _isOTPSent ? "OTP sent successfully! Please check your email." : "Failed to send OTP. Please try again.";

            if (_isOTPSent)
            {
                _isSendingOTP = false;
                popup.OpenModal();
                StateHasChanged();
            }

            _isSendingOTP = false;
        }
    }

    private async Task HandleClose(bool successStatus)
    {

        _isOTPSent = false;
        _responseMessage = null;


        _isSuccessfullyValidated = successStatus;

        if (_isSuccessfullyValidated)
        {
            _isValidatedFromPopup = true;
            //StateHasChanged();
            _isLoading = true;
            await Task.Delay(5000);
            var userEmail = await localStorageUtility.GetItemFromStorageAsync<string>("password-reset-user");
            _changePasswordModel = new ChangePasswordDto() { Email = userEmail };
            _isLoading = false; _isValidatedFromPopup = false;
        }

        popup.CloseModal();
    }
    private async Task HandlePasswordChange()
    {
        _isChangingPassword = true;_changePasswordResponseMessage = null;

        await Task.Delay(5000);

        // _passwordChangeStatus = DateTime.Now.Second % 2 == 0;
        // _changePasswordResponseMessage = _passwordChangeStatus ? "Password Changed Successfully" : "Password Change Failed.";

        var result = await changePasswordHandler.Handle(_changePasswordModel);
        _passwordChangeStatus = result.isSuccessful;_changePasswordResponseMessage = result.responseMessage;

        if (_passwordChangeStatus)
        {
            _changePasswordModel = new();

            _ = Task.Run(async () =>
            {
                await Task.Delay(2000);
                var clearStorage = await localStorageUtility.RemoveAllItemsFromStorageAsync("password-reset-user", "password-reset-token");
                navigationManager.NavigateTo("/login", forceLoad: true);
            });
        }

        var userEmail = await localStorageUtility.GetItemFromStorageAsync<string>("password-reset-user");
        _changePasswordModel = new ChangePasswordDto() { Email = userEmail };
        _isChangingPassword = false;
    }
}
