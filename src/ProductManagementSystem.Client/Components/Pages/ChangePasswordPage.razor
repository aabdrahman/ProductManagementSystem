
@page "/forgot-password"

<PageTitle>Forgot Password</PageTitle>

@if (_isLoading)
{
    <Spinner Description="Validating Email" />
}

<div class="auth-container">
    <div class="auth-card">
        <h2>Forgot Password</h2>
        <p class="auth-subtext">
            Enter your email address and we'll send you a link to reset your password.
        </p>

        <div class="form-group">
            <label>Email Address</label>
            <input @bind="_emailAddress" type="email" placeholder="Enter your email" />
        </div>

        <button class="auth-btn" @onclick="HandleSendOTP">Send Reset Link</button>

        <div class="auth-footer">
            <a href="/login">Back to Login</a>
        </div>
    </div>
</div>

@code {

    private string _emailAddress;
    private bool _isSendingOTP = false;

    private bool _isLoading = false;

    private async Task HandleSendOTP()
    {
        if (!string.IsNullOrEmpty(_emailAddress))
        {
            _isSendingOTP = true;

            await Task.Delay(4000);


        }
    }
}
