@page "/admin/manage-content"

@layout ProductManagementSystem.Client.Components.Layout.AdminLayout

@attribute [Authorize(Roles = "ADMIN,SYSTEM")]

<PageTitle>Manage Site Content - About Us and Why Choose Us</PageTitle>

@if (_isRendering)
{
    <Spinner Description="Loading Site Content" />
}
else
{
    <section class="site-content-management-page">

        <div class="site-content-management-page-header">
            <h2>
                Manage Site Content - About Us and Why Choose Us
            </h2>

            <p>
                Manage your site content and configure what users see 
            </p>
        </div>

        @if(_fetchedWhyChooseUsDetails is not null)
        {
            <WhyChooseUsContentDetails WhyChooseUsDetails="_fetchedWhyChooseUsDetails" ResponseMessage="@_getWhyChooseUsResponse" HandleAddDetails="OnAddNewWhyChooseUs" HandleEditDetails="OnEditWhyChoosUsContent" HandleViewDetails="OnViewWhyChooseUsContent" HandleDeleteDetails="OnDeleteWhyChooseUsContent" />
        }

        @if(_fetchedAboutUsDetails is not null)
        {
            <AboutUsContentListView AboutUsItemsDetails="_fetchedAboutUsDetails" ResponseMessage="@_getAboutUsResponse" HandleAddDetails="OnAddNewAboutUs" HandleViewDetails="OnViewAboutUsContent"  HandleDeleteDetails="OnDeleteAboutUsContent" HandleEditDetails="OnEditAbutUsContent"/>
        }

    </section>

    <Popup Title="@_title" ShowCloseButton="@_showCloseButton" @ref="popup">
        <Body>
            @if(_operationToPerform == OperationType.AddWhyChooseUs)
            {
                <AddWhyChooseUs HandleClose="HandleClose" />
            }
            else if(_operationToPerform == OperationType.EditWhyChooseUs)
            {
                <EditWhyChooseUs WhyChooseUsContentToEdit="@_selectedWhyChooseUs" HandleClose="HandleClose" />
            }
            else if(_operationToPerform == OperationType.ViewWhyChooseUsDetails)
            {
                <WhyChooseUsContent WhyChooseUsDetail="_selectedWhyChooseUs" />
            }
            else if(_operationToPerform == OperationType.DeleteWhyChooseUsDetails)
            {
                <DeleteWhyChooseUsContent WhyChooseUsToDelete="@_selectedWhyChooseUs" HandleClose="HandleClose" />
            }
            else if(_operationToPerform == OperationType.AddAboutUs)
            {
                <AddAboutUs HandleClose="HandleAboutUsClose" />
            }
            else if(_operationToPerform == OperationType.EditAboutUs)
            {
                <EditAboutUs AboutUsContentToEdit="@_selectedAboutUsContent" HandleClose="HandleAboutUsClose" />
            }
            else if(_operationToPerform == OperationType.ViewAboutUsDetails)
            {
                <AboutUsContent AboutUsDetail="@_selectedAboutUsContent" />
            }
            else if(_operationToPerform == OperationType.DeleteAboutUsDetails)
            {
                <DeleteAboutUsContent AboutUsToDelete="@_selectedAboutUsContent" HandleClose="HandleAboutUsClose"  />
            }
        </Body>
    </Popup>
}


@code {

    private bool _isRendering;
    private IEnumerable<WhyChooseUsDto> _fetchedWhyChooseUsDetails;
    private IEnumerable<AboutUsDto> _fetchedAboutUsDetails;
    private string _getWhyChooseUsResponse;
    private string _getAboutUsResponse;

    private OperationType _operationToPerform;
    private string _title;
    private bool _showCloseButton = false;
    private Popup popup;
    private WhyChooseUsDto _selectedWhyChooseUs;
    private AboutUsDto _selectedAboutUsContent;

    protected override async Task OnInitializedAsync()
    {
        _isRendering = true;

        await Task.Delay(250);

        var result = getWhyChooseUsHandler.Handle();
        var aboutUsContentResult = getAboutUsContentHandler.Handle();

        await Task.WhenAll(result, aboutUsContentResult);

        var getWhyChooseUsResult = result.Result;
        var getAboutUsContentResult = aboutUsContentResult.Result;

        _fetchedWhyChooseUsDetails = getWhyChooseUsResult.contentItems;
        _getWhyChooseUsResponse = getWhyChooseUsResult.responseMessage;

        _fetchedAboutUsDetails = getAboutUsContentResult.contentDetails;
        _getAboutUsResponse = getAboutUsContentResult.responseMessage;

        _isRendering = false;
    }

    // protected override async Task OnAfterRenderAsync(bool firstRender)
    // {
        
    // }
}


@code{

    private void OnAddNewWhyChooseUs()
    {
        _title = "Add New Why Choose Us";
        _operationToPerform = OperationType.AddWhyChooseUs;

        popup.OpenModal();
    }

    private void OnEditWhyChoosUsContent(WhyChooseUsDto selectedWhyChooseUsContent)
    {
        _selectedWhyChooseUs = selectedWhyChooseUsContent;
        _title = "Edit Why Choose Us Content Details";
        _showCloseButton = false;
        _operationToPerform = OperationType.EditWhyChooseUs;

        popup.OpenModal();
    }

    private void OnViewWhyChooseUsContent(WhyChooseUsDto selectedWhyChooseUsContent)
    {
        _selectedWhyChooseUs = selectedWhyChooseUsContent;
        _title = "Content Details";
        _showCloseButton = true;
        _operationToPerform = OperationType.ViewWhyChooseUsDetails;

        popup.OpenModal();
    }

    private void OnDeleteWhyChooseUsContent(WhyChooseUsDto selectedWhyChooseUsContent)
    {
        _selectedWhyChooseUs = selectedWhyChooseUsContent;
        _title = "Delete Content";
        _showCloseButton = false;
        _operationToPerform = OperationType.DeleteWhyChooseUsDetails;

        popup.OpenModal();
    }

    private async Task HandleClose(bool refreshDecision = false)
    {

        _title = "";
        _operationToPerform = default;

        if (refreshDecision)
        {
            _isRendering = true;

            var result = await getWhyChooseUsHandler.Handle();
            _fetchedWhyChooseUsDetails = result.contentItems;
            _getAboutUsResponse = result.responseMessage;

            _isRendering = false;
        }

        popup.CloseModal();

        // StateHasChanged();
    }

    private async Task HandleAboutUsClose(bool refreshDecision = false)
    {
        _title = "";
        _operationToPerform = default;


        if (refreshDecision)
        {
            _isRendering = true;

            var result = await getAboutUsContentHandler.Handle();
            _fetchedAboutUsDetails = result.contentDetails.ToList();
            _getWhyChooseUsResponse = result.responseMessage;

            _isRendering = false;
        }

        popup.CloseModal();

        // StateHasChanged();
    }

    private void OnAddNewAboutUs()
    {
        _title = "Add New Aboute Us";
        _operationToPerform = OperationType.AddAboutUs;

        popup.OpenModal();
    }

    private void OnEditAbutUsContent(AboutUsDto selectedAboutUsContent)
    {
        _selectedAboutUsContent = selectedAboutUsContent;
        _title = "Edit About Us Content Details";
        _showCloseButton = false;
        _operationToPerform = OperationType.EditAboutUs;

        popup.OpenModal();
    }

    private void OnViewAboutUsContent(AboutUsDto selectedAboutUsContent)
    {
        _selectedAboutUsContent = selectedAboutUsContent;
        _title = "Content Details";
        _showCloseButton = true;
        _operationToPerform = OperationType.ViewAboutUsDetails;

        popup.OpenModal();
    }

    private void OnDeleteAboutUsContent(AboutUsDto selectedAboutUsContent)
    {
        _selectedAboutUsContent = selectedAboutUsContent;
        _title = "Delete Content";
        _showCloseButton = false;
        _operationToPerform = OperationType.DeleteAboutUsDetails;

        popup.OpenModal();
    }

    enum OperationType
    {
        None,
        AddWhyChooseUs,
        EditWhyChooseUs,
        ViewWhyChooseUsDetails,
        DeleteWhyChooseUsDetails,
        AddAboutUs,
        EditAboutUs,
        ViewAboutUsDetails,
        DeleteAboutUsDetails
    }
}