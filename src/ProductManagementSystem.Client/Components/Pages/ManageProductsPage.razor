
@page "/admin/products"
@using ProductManagementSystem.Client.Components.SharedContent

@layout ProductManagementSystem.Client.Components.Layout.AdminLayout

@inject GetProductsHandler getProductsHandler

@rendermode InteractiveServer

<section class="product-management">
    <div class="management-header">
        <h2>Product Management</h2>
        <p>Manage inventory, update pricing, and control available products.</p>

        <button role="button" @onclick="HandleAddNewProduct" class="add-product-btn">
            ➕ Add New Product
        </button>
    </div>

    @if (_isLoading)
    {
        <p>Loading products...</p>
    }
    else 
    {
        if (_products is not null && !_products.Any())
        {
            <div class="no-products">
                <h3>No products available</h3>
                <p>Start by adding your first product.</p>
            </div>
        }
        else if(_products is not null && _products.Any())
        {
            <ProductsView Products="_products" HandleRestock="HandleRestockProduct" HandleUpdate="HandleUpdateProduct" HandleDelete="HandleDeleteProduct" />
        }

    }

</section>

<ProductCategoryView HandleAddCategory="HandleAddNewProductCategory" HandleDelete="HandleDeleteProductCategory" />

<Popup @ref="popup" Title="@_title" ShowCloseButton="false">
    <Body>
        @if(_operationToPerform == OperationType.AddNewProduct)
        {
            <AddNewProduct HandleClose="HandleAddProductClose" />
        }
        else if(_operationToPerform == OperationType.RestockProduct)
        {
            <RestockProduct ProductToUpdate="_selectedProduct" HandleClose="HandleRestockProductClose" />
        }
        else if(_operationToPerform == OperationType.UpdateProduct)
        {
            <UpdateProduct ProductToUpdate="_selectedProduct" HandleClose="HandleUpdateProductClose" />
        }
        else if(_operationToPerform == OperationType.DeleteProduct)
        {
            <DeleteProduct ProductToDelete="@_selectedProduct" HandleClose="HandleDeleteProductClose" />
        }
        else if(_operationToPerform == OperationType.AddNewProductCategory)
        {
            <AddProductCategory HandleClose="HandleAddProductCategoryClose" />
        }
        else if(_operationToPerform == OperationType.DeleteProductCategory)
        {
            <DeleteProductCategory HandleClose="HandleDeleteProductCategoryClose" ProductCategoryToDelete="_selectedProductCategory" />
        }
    </Body>
</Popup>

@code {
    private IEnumerable<ProductDto> _products;
    private bool _isLoading;

    private string _responseMessage;
    private bool _isSuccessful;

    private string _title;
    private bool _showCloseButton = false;
    private OperationType _operationToPerform;
    private Popup popup;
    private ProductDto _selectedProduct;
    private ProductCategoryDto _selectedProductCategory;


    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;

        await Task.Delay(500);

        var response = await getProductsHandler.Handle();
        _products = response.products; 

        _isLoading = false;
    }

    private void HandleAddNewProduct()
    {
        _operationToPerform = OperationType.AddNewProduct;
        HandleOpen("Add New Product", false);
    }

    private async Task HandleAddProductClose(bool refreshDecision)
    {

        if (refreshDecision)
        {
            var response = await getProductsHandler.Handle();
            _products = response.products;
        }

        popup.CloseModal();
    }


    private async Task HandleRestockProductClose(bool refreshDecision)
    {
        _title = null;
        _selectedProduct = null;
        _operationToPerform = default;

        if (refreshDecision)
        {
            var response = await getProductsHandler.Handle();
            _products = response.products;
        }

        popup.CloseModal();
    }

    private void HandleRestockProduct(ProductDto selectedProduct)
    {
        _selectedProduct = selectedProduct;
        _operationToPerform = OperationType.RestockProduct;

        HandleOpen("Restock Product", false);
    }

    private void HandleUpdateProduct(ProductDto selectedProduct)
    {
        _selectedProduct = selectedProduct;
        _operationToPerform = OperationType.UpdateProduct;

        HandleOpen($"Update Product - {_selectedProduct.Name}", false);
    }

    private void HandleDeleteProduct(ProductDto selectedProduct)
    {
        _selectedProduct = selectedProduct;
        _operationToPerform = OperationType.DeleteProduct;

        HandleOpen($"Delete Product - {_selectedProduct.Name}", false);
    }

    private async Task HandleDeleteProductClose(bool refreshDecision)
    {
        _title = null;
        _selectedProduct = null;
        _operationToPerform = default;

        if (refreshDecision)
        {
            var response = await getProductsHandler.Handle();
            _products = response.products;
        }

        popup.CloseModal();
    }

    private async Task HandleUpdateProductClose(bool refreshDecision)
    {
        _title = null;
        _selectedProduct = null;
        _operationToPerform = default;

        if (refreshDecision)
        {
            var response = await getProductsHandler.Handle();
            _products = response.products;
        }

        popup.CloseModal();
    }

}


@code{

    enum OperationType
    {
        None,
        AddNewProduct,
        RestockProduct,
        UpdateProduct,
        DeleteProduct,
        AddNewProductCategory,
        DeleteProductCategory
    }

    private void HandleOpen(string title, bool showCloseButton)
    {
        _title = title;
        _showCloseButton = false;

        popup.OpenModal();
    }


    private void HandleAddNewProductCategory()
    {
        _operationToPerform = OperationType.AddNewProductCategory;
        HandleOpen("Add New Product Category", false);
    }

    private void HandleDeleteProductCategory(ProductCategoryDto selectedProductCategory)
    {
        _selectedProductCategory = selectedProductCategory;
        _operationToPerform = OperationType.DeleteProductCategory;
        HandleOpen($"Delete Product Category - {_selectedProductCategory.Name}", false);
    }

    private async Task HandleAddProductCategoryClose(bool refreshDecision)
    {

        if (refreshDecision)
        {
            var response = await getProductsHandler.Handle();
            _products = response.products;
        }

        popup.CloseModal();
    }

    private async Task HandleDeleteProductCategoryClose(bool refreshDecision)
    {

        if (refreshDecision)
        {
            var response = await getProductsHandler.Handle();
            _products = response.products;
        }

        popup.CloseModal();
    }
}
