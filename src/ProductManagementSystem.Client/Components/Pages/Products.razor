
@inject GetProductsHandler getProductsHandler
@inject GetProductCategoryHandler getProductCategoryHandler

@rendermode InteractiveServer

@if(_products is not null)
{
    <section id="products" class="products">

        <div class="products-header">
            <h2>Featured Products</h2>
            <p>
                Browse our available products and place your order quickly and easily.
            </p>
        </div>

        <!-- 🔎 Filter Bar -->
        <div class="products-filter">
            @if(_categories is not null && _categories.Any())
            {
                <div class="filter-group">
                    <label>Category</label>
                    <select class="filter-input" @bind="_selectedCategory" @bind:after="FilterProducts">
                        <option value="">All Categories</option>
                        @foreach (var category in _categories)
                        {
                            <option value="@category.Name">@category.Name</option>
                        }
                    </select>
                </div>
            }
            

            <div class="filter-group">
                <label>Product Name</label>
                <input class="filter-input"
                           placeholder="Search by name..."
                           @bind="_searchTerm" @bind:event="oninput" @bind:after="FilterProducts" />
            </div>

            <!-- Clear Filters Button -->
            <button class="clear-filter-btn" disabled="@(!_isClearFilterAllowed)" type="button" @onclick="ClearFilters">
                Clear Filters
            </button>
        </div>

        @if (!_isLoading)
        {
            if (!_filteredProducts.Any())
            {
                <div class="no-products" id="noProducts">
                    <h3>No products found</h3>
                    <p>
                        Try adjusting your filters or search keywords.
                    </p>
                </div>
            }
            else
            {
                <div class="products-grid">
                    @foreach (var product in _filteredProducts)
                    {
                        <ProductCard Product="product" HandleOrderProduct="HandleOpenOrderProduct" />
                    }
                </div>
            }
        }

        @* <div class="products-grid">

            @foreach (var product in _filteredProducts)
            {
                <ProductCard Product="product" />
            }

        </div> *@

    </section>
}

<Popup @ref="popup" Title="@_title" ShowCloseButton="false">
    <Body>
        @if(_operationType == OperationToPerform.OrderProduct)
        {
            <OrderProduct ProductToOrder="_selectedProduct" HandleClose="OnHandleClose" />
        }
    </Body>
</Popup>


@code{
    private IEnumerable<ProductDto> _products;
    private List<ProductDto> _filteredProducts;

    private bool _isLoading = true;

    private IEnumerable<ProductCategoryDto> _categories;
    private string _selectedCategory;
    private string _searchTerm;
    private string _reponseMessage;

    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(500);

        var response = await getProductsHandler.Handle();


        _products = response.products; _reponseMessage = response.message;

        var getProductCategoryResponse = await getProductCategoryHandler.Handle();
        _categories = getProductCategoryResponse.productCategories;

        // var testProducts = new List<ProductDto>

        _filteredProducts = _products.ToList();
        _isLoading = false;

    }

    private bool _isClearFilterAllowed => !(string.IsNullOrWhiteSpace(_searchTerm) && string.IsNullOrWhiteSpace(_selectedCategory));

    private void FilterProducts()
    {

        _isLoading = true;

        _filteredProducts = _products.Where
                        (
                            x => 

                                (string.IsNullOrWhiteSpace(_selectedCategory) || x.CategoryName.Contains(_selectedCategory, StringComparison.CurrentCultureIgnoreCase)) &&
                                (string.IsNullOrWhiteSpace(_searchTerm) || x.Name.Contains(_searchTerm, StringComparison.CurrentCultureIgnoreCase))

                        ).ToList();

        _isLoading = false;
    }

    private void ClearFilters()
    {
        _searchTerm = "";
        _selectedCategory = "";

        _filteredProducts = _products.ToList();
    }
}

@code{
    private string _title;
    private OperationToPerform _operationType;
    private ProductDto _selectedProduct;
    private Popup popup;

    private async Task OnHandleClose(bool refreshDecision)
    {
        _operationType = default;
        _title = "";

        if (refreshDecision)
        {
            var response = await getProductsHandler.Handle();


            _products = response.products; _reponseMessage = response.message;

            var getProductCategoryResponse = await getProductCategoryHandler.Handle();
            _categories = getProductCategoryResponse.productCategories;

            // var testProducts = new List<ProductDto>

            _filteredProducts = _products.ToList();
        }

        _selectedProduct = null;
        popup.CloseModal();
    }

    private void HandleOpenOrderProduct(ProductDto selectedProduct)
    {
        _selectedProduct = selectedProduct;
        _title = $"Order Product - {_selectedProduct.Name}";
        _operationType = OperationToPerform.OrderProduct;
        popup.OpenModal();
    }

    enum OperationToPerform
    {
        None,
        OrderProduct
    }
}
