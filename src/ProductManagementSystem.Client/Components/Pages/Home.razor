@page "/"
@using ProductManagementSystem.Client.Components.SharedContent

@rendermode InteractiveServer

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

Welcome to your new app.

<button @onclick="ShowPopup" role="button">Open Modal</button>

<Popup @ref="popup" Title="@_title" ShowCloseButton="true">
    <Body>
        @if(string.IsNullOrEmpty(_title))
        {
            <p>Loading...</p>
        }
        else
        {
            <p>Modal Content Loaded!</p>
            <Status StatusMessage="@(DateTime.Now.Second % 2 != 0 ? $"The time is: {DateTime.Now.ToString("f")}" : $"The time is: {DateTime.Now.ToString("f")}")" SuccessStatus="@(DateTime.Now.Second % 2 != 0)" />
        }
    </Body>
</Popup>


@code{

    private Popup popup;
    private string _title;

    private void ShowPopup()
    {
        Console.WriteLine($"Show Popup Called.........");
        _title = "Test Modal View";
        popup.OpenModal();
        Console.WriteLine($"Show Popup Executed.........");
    }
}
