@using Microsoft.AspNetCore.Components.Forms

@inject AddProductImageHandler addProductImageHandler
@inject RemoveProductImageHandler removeProductImageHandler

@if(_isUploading)
{
    <Spinner Description="Uploading Product Image" />
}


<div class="image-upload-wrapper">

    <!-- Upload Area -->
    <label class="upload-zone">

        <InputFile OnChange="HandleFilesSelected"
                   multiple
                   accept="image/*" />

        <div class="upload-content">
            <span class="upload-icon">+</span>
            <p>Upload Product Images</p>
            <small>PNG, JPG, JPEG</small>
        </div>

    </label>

    @if (_existingImages.Any())
    {
        <div class="existing-images-section">

            <h4>Existing Images</h4>

            <div class="actions">
                <button class="btn apply" disabled="@(!_deletedImages.Any())" @onclick="ApplyRemovedImages">
                    Remove Images

                    <span>
                        (@_deletedImages.Count)
                    </span>
                    
                </button>
            </div>



            <div class="preview-grid">

                @for (int i = 0; i < _existingImages.Count; i++)
                {
                    var index = i;
                    var isRemoved = _removedIndexes.Any(x => x == index);

                    <div class="preview-card @(_removedIndexes.Any(x => x == index) ? "removed" : "")">

                        <img src="@_existingImages[index]"
                             alt="Existing Image" />

                        @if (isRemoved)
                        {
                            <button type="button" class="undo-btn" hidden="@isRemoved" @onclick="(() => UndoRemoveExistingImage(index))">
                                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" class="bi bi-arrow-counterclockwise" viewBox="0 0 16 16">
                                    <path fill-rule="evenodd" d="M8 3a5 5 0 1 1-4.546 2.914.5.5 0 0 0-.908-.417A6 6 0 1 0 8 2z" />
                                    <path d="M8 4.466V.534a.25.25 0 0 0-.41-.192L5.23 2.308a.25.25 0 0 0 0 .384l2.36 1.966A.25.25 0 0 0 8 4.466" />
                                </svg>
                            </button>
                        }
                        else
                        {
                            <button type="button"
                                    class="remove-btn"
                                    @onclick="(() => RemoveExistingImage(index))">
                                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" class="bi bi-x-lg" viewBox="0 0 16 16">
                                    <path d="M2.146 2.854a.5.5 0 1 1 .708-.708L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8z" />
                                </svg>
                            </button>
                        }

                        <button type="button"
                                class="remove-btn"
                                @onclick="(() => RemoveExistingImage(index))">
                            ×
                        </button>

                    </div>
                }

            </div>

        </div>
    }

    <!-- Preview Images -->
    @if (_imagePreviews.Any())
    {
        <div class="new-image-section">

            <h4>New Uploaded Images</h4>

            @if (_selectedFiles.Any())
            {
                <div class="upload-count">
                    @_selectedFiles.Count
                    @(_selectedFiles.Count == 1 ? "image" : "images")
                    selected
                </div>
            }

        </div>
        <div class="preview-grid">

            @for (int i = 0; i < _imagePreviews.Count; i++)
            {
                var index = i;

                <div class="preview-card">

                    <img src="@_imagePreviews[index]"
                         alt="Preview Image" />


                    <button type="button"
                            class="remove-btn"
                            @onclick="(() => RemoveImage(index))">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" class="bi bi-x-lg" viewBox="0 0 16 16">
                            <path d="M2.146 2.854a.5.5 0 1 1 .708-.708L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8z" />
                        </svg>
                    </button>


                </div>
            }

        </div>
    }

    @if(_responseMessage is not null)
    {
        <Status StatusMessage="@_responseMessage" SuccessStatus="@_isSuccessful" />
    }
    

    <div class="form-actions">
                            
        <button class="btn submit" @onclick="HandleUpload"
                disabled="@(_isSuccessful || _isUploading)">
                @(!_isUploading ? "Upload Image" : "Uploading Image...")
        </button>

        <button class="btn cancel" disabled="@_isUploading" @onclick="(() => CloseModal(_isSuccessful))">Cancel</button>
    </div>

</div>

@code {

    private List<IBrowserFile> _selectedFiles = new();
    private List<string> _existingImages = [];
    private List<string> _deletedImages = [];
    private List<int> _removedIndexes = [];

    private List<string> _imagePreviews = new();

    private bool _isLoading = false;
    private bool _isUploading = false;
    private bool _isSuccessful = false;
    private string _responseMessage;

    [Parameter]
    public EventCallback<List<IBrowserFile>> OnImagesChanged { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<bool> HandleClose { get; set; }

    [Parameter, EditorRequired]
    public ProductDto Product { get; set; }

    protected override void OnParametersSet()
    {
        _existingImages = Product.ProductImages.ToList();
    }

    private async Task HandleFilesSelected(InputFileChangeEventArgs e)
    {
        _responseMessage = null;
        _selectedFiles.Clear();
        var files = e.GetMultipleFiles();

        foreach (var file in files)
        {
            _selectedFiles.Add(file);

            using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);

            using var memoryStream = new MemoryStream();

            await stream.CopyToAsync(memoryStream);

            var imageBase64 = Convert.ToBase64String(memoryStream.ToArray());

            var imageUrl =
                $"data:{file.ContentType};base64,{imageBase64}";

            _imagePreviews.Add(imageUrl);
        }

        await OnImagesChanged.InvokeAsync(_selectedFiles);
    }

    private async Task RemoveImage(int index)
    {
        _responseMessage = null;
        _selectedFiles.RemoveAt(index);

        _imagePreviews.RemoveAt(index);

        await OnImagesChanged.InvokeAsync(_selectedFiles);
    }

    private async Task CloseModal(bool refreshDecision = false)
    {
        await HandleClose.InvokeAsync(refreshDecision);
    }

    private async Task HandleUpload()
    {
        _responseMessage = null;
        if (!_selectedFiles.Any())
        {
            _responseMessage = "Please select at least one image to upload.";
            return;
        }

        _isUploading = true;
        var response = await addProductImageHandler.Handle(Product.Id, _selectedFiles);
        _isSuccessful = response.isSuccessful;
        _responseMessage = response.responseMessage;

        _isUploading = false;

        if (_isSuccessful)
        {
            _ = Task.Run(async () =>
            {
                await Task.Delay(2000);
                await CloseModal(true);
            });

            await CloseModal(true);
        }
    }



    private void RemoveExistingImage(int index)
    {
        var imageToRemove = _existingImages[index];

        _deletedImages.Add(imageToRemove);
        _removedIndexes.Add(index);

        StateHasChanged();

        //_existingImages.RemoveAt(index);
    }

    public void UndoRemoveExistingImage(int index)
    {
        var imageToUndo = _existingImages[index];
        _deletedImages.Remove(imageToUndo);
        _removedIndexes.Remove(index);
        StateHasChanged();
    }

    private async Task ApplyRemovedImages()
    {
        _responseMessage = null;
        _isUploading = true;

        if (!_removedIndexes.Any())
        {
            _responseMessage = "No Items selected to remove.";
            _isUploading = true;
            return;
        }

        var removeResponse = await removeProductImageHandler.Handle(_deletedImages);

        _isSuccessful = removeResponse.isSuccessful;
        _responseMessage = removeResponse.responseMessage;

        if (_isSuccessful)
        {
            _existingImages = _existingImages.Where(x => !_deletedImages.Contains(x)).ToList();
            _removedIndexes.Clear();
            _deletedImages.Clear();
            StateHasChanged();
        }


        _isUploading = false;
    }
}