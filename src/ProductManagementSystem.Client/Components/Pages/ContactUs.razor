
<section id="contact" class="contact">
    <div class="contact-header">
        <h2>Contact Us</h2>
        <p>We'd love to hear from you! Send us a message or reach out through the details below.</p>
    </div>

    <div class="contact-container">

        <!-- Contact Info -->
        <div class="contact-info">
            <p><strong>Email:</strong> info@yourcompany.com</p>
            <p><strong>Phone:</strong> +234 800 123 4567</p>
            <p><strong>Address:</strong> Lagos, Nigeria</p>
        </div>

        <!-- Contact Form -->
        <div class="contact-form">

            @if(_createFeedbackModel is not null)
            {
                <EditForm Model="_createFeedbackModel" FormName="contactForm">

                    <DataAnnotationsValidator />

                    <div class="form-group">
                        <label for="name">Your Name</label>
                        <InputText @bind-Value="_createFeedbackModel.Name" placeholder="Enter your name" />
                        <ValidationMessage For="(() => _createFeedbackModel.Name)" />
                    </div>

                    <div class="form-group">
                        <label for="email">Email Address</label>
                        <InputText @bind-Value="_createFeedbackModel.UserEmail" placeholder="Enter your email" />
                        <ValidationMessage For="(() => _createFeedbackModel.UserEmail)" />
                    </div>

                    <div class="form-group">
                        <label for="message">Message</label>
                        <InputTextArea @bind-Value="_createFeedbackModel.Message" rows="5" placeholder="Write your message..." />
                        <ValidationMessage For="(() => _createFeedbackModel.Message)" />
                    </div>

                    <div class="form-actions">

                    </div>

                </EditForm>
            }
        </div>

    </div>
</section>

@code {

    private CreateFeedbackDto _createFeedbackModel;

    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(250);
        _createFeedbackModel = new CreateFeedbackDto();
    }
}
