
@rendermode InteractiveServer


<section id="contact" class="contact">
    <div class="contact-header">
        <h2>Contact Us</h2>
        <p>We'd love to hear from you! Send us a message or reach out through the details below.</p>
    </div>

    <div class="contact-container">

        <!-- Contact Info -->
        <div class="contact-info">
            <p><strong>Email:</strong> info@yourcompany.com</p>
            <p><strong>Phone:</strong> +234 800 123 4567</p>
            <p><strong>Address:</strong> Lagos, Nigeria</p>
        </div>

        <!-- Contact Form -->
        <div class="contact-form">

            @if(_createFeedbackModel is not null)
            {
                <EditForm Model="_createFeedbackModel" OnValidSubmit="HandleSubmitFeedback" FormName="contactForm">

                    <DataAnnotationsValidator />

                    @if(_responseMessage is not null)
                    {
                        <Status StatusMessage="@_responseMessage" SuccessStatus="@_isSuccessful" />
                    }

                    <div class="form-group">
                        <label for="name">Your Name</label>
                        <InputText @bind-Value="_createFeedbackModel.Name" placeholder="Enter your name" />
                        <ValidationMessage For="(() => _createFeedbackModel.Name)" />
                    </div>

                    <div class="form-group">
                        <label for="email">Email Address</label>
                        <InputText @bind-Value="_createFeedbackModel.UserEmail" placeholder="Enter your email" />
                        <ValidationMessage For="(() => _createFeedbackModel.UserEmail)" />
                    </div>

                    <div class="form-group">
                        <label for="message">Message</label>
                        <InputTextArea @bind-Value="_createFeedbackModel.Message" rows="5" placeholder="Write your message..." />
                        <ValidationMessage For="(() => _createFeedbackModel.Message)" />
                    </div>

                    <div class="form-actions">


                        <button class="btn submit" disabled="@_isProcessing" type="submit">
                            @(_isProcessing ? "Submitting Details" : "Submit Details")
                        </button>

                        <button class="btn cancel" disabled="@_isProcessing" @onclick="Clear" type="button">Cancel Review</button>

                    </div>

                </EditForm>
            }
        </div>

    </div>
</section>

@code {

    private CreateFeedbackDto _createFeedbackModel;

    private bool _isProcessing;
    private bool _isSuccessful;
    private string _responseMessage;

    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(250);
        _createFeedbackModel = new CreateFeedbackDto();
    }

    private async Task Clear()
    {
        _createFeedbackModel = new();
    }

    private async Task HandleSubmitFeedback()
    {
        _isProcessing = true;
        _responseMessage = null;

        // await Task.Delay(5000);
        // _isSuccessful = DateTime.Now.Second % 2 == 0;
        // _responseMessage = _isSuccessful ? "Feedback Sucessfully Submitted" : "Feedback Submission Failed.";

        var result = await addFeedbackHandler.Handle(_createFeedbackModel);
        _isSuccessful = result.isSuccessful;
        _responseMessage = result.message;

        if (_isSuccessful)
        {
            _ = Task.Run(async () =>
           {
               await Task.Delay(5000);
               _createFeedbackModel = new();
               _responseMessage = null;

               await InvokeAsync(StateHasChanged);
           });
        }

        _isProcessing = false;
    }
}
