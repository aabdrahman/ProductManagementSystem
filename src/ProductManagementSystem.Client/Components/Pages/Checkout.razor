@page "/checkout"

@rendermode InteractiveServer

@attribute [Authorize]

@inject GetMultipleProductsHandler getMultipleProductsHandler
@inject AddOrderHandler addOrderHandler
@inject GetUserDetailsHandler getUserDetailsHandler


@if (_isPlacingOrder)
{
    <Spinner Description="Placing User Order" />
}

<section class="checkout-page">
    <div class="checkout-header">
        <h2>Checkout</h2>
        <p>Review your selected products before placing your order.</p>
    </div>

    @if (_isLoading)
    {
        <Spinner Description="Fetching Orders" />
    }
    else if (!_orders.Any())
    {
        <div class="empty-cart">
            <h3>Your cart is empty</h3>
            <p>You haven’t added any products yet.</p>
            <a href="/#products" class="back-to-products">Browse Products</a>
        </div>
    }
    else
    {
        if(_products is not null)
        {
            <div class="checkout-cards">
                @foreach (var item in _orders)
                {
                    <div class="checkout-card">
                        <div class="checkout-card-main">
                            <h4 class="product-name">@(_products.Where(x => x.Id == item.ProductId).Select(x => x.Name).FirstOrDefault())</h4>

                            <p class="price">
                                Price: <strong>@((_products.Where(x => x.Id == item.ProductId).Select(x => x.SellingPrice).FirstOrDefault()).ToString("C"))</strong>
                            </p>

                            <p class="qty">
                                Quantity: <strong>@item.QuantityOrdered</strong>
                            </p>

                            <p class="line-total">
                                Total: <strong>@((item.QuantityOrdered * _products.Where(x => x.Id == item.ProductId).Select(x => x.SellingPrice).FirstOrDefault()).ToString("C"))</strong>
                            </p>
                        </div>

                        <div class="checkout-card-actions">
                            <button class="remove-btn" @onclick="() => RemoveItem(item)">
                                Remove
                            </button>
                        </div>
                    </div>

                    
                }
            </div>

            @if(_createOrderModel is not null)
            {
                <div class="checkout-form-card">
                    <h3>Customer Details</h3>

                    @if(_responseMessage is not null)
                    {
                        <Status SuccessStatus="@_isSuccessful" StatusMessage="@_responseMessage" />
                    }

                    <EditForm Model="_createOrderModel" OnValidSubmit="PlaceOrder">
                        <DataAnnotationsValidator />

                        <div class="form-group">
                            @* <label>Full Name</label> *@

                            <FullName @bind-Value="_createOrderModel.FullName" ReadOnly="@_isValidUserDetails" />

                            <ValidationMessage For="(() => _createOrderModel.FullName)"  />
                        </div>

                        <div class="form-group">
                            <label>Email</label>
                            <InputText @bind-Value="_createOrderModel.CreatedBy" readonly="@true" />
                            <ValidationMessage For="(() => _createOrderModel.CreatedBy)"  />
                        </div>

                        <div class="form-group">
                            <label>Phone Number</label>
                            <InputText @bind-Value="_createOrderModel.PhoneNumber" />
                            <ValidationMessage For="(() => _createOrderModel.PhoneNumber)"/>
                        </div>

                        <div class="form-group">
                            <label>Delivery Address</label>
                            <InputTextArea @bind-Value="_createOrderModel.DeliveryAddress" rows="3" />
                            <ValidationMessage For="(() => _createOrderModel.DeliveryAddress)" />
                        </div>

                        <button type="submit" disabled="@_isPlacingOrder" class="place-order-btn">
                            @(_isPlacingOrder ? "Placing Order........" : "Place Order")
                        </button>
                    </EditForm>
                </div>
            }

            <div class="checkout-summary">
                <p class="total">
                    Total: <strong>@TotalAmount.ToString("C")</strong>
                </p>

            </div>

        }
        


    }
</section>

@code {

    private List<CreateOrderLineItemDto> _orders = new();
    private bool _isLoading = true;
    private IEnumerable<ProductDto> _products;

    private string _getUserDetailsResponseMessage;
    private UserDto? _userToCheckout;

    private CreateOrderDto _createOrderModel;
    private bool _isPlacingOrder = false;
    private string _responseMessage;
    private bool _isSuccessful;
    private int _loggedInUserId = 0;
    private bool _isValidUserDetails = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await authStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if(user != null)
        {
            string userId = user.FindFirst(x => x.Type.EndsWith("nameidentifier"))?.Value ?? "0";

            var isValidUser = int.TryParse(userId, out _loggedInUserId);
        }

        await LoadCartAsync();
    }

    private async Task LoadCartAsync()
    {
        _isLoading = true;

        var stored = await localStorageUtility.GetItemFromStorageAsync<IEnumerable<CreateOrderLineItemDto>>("orders");

        _orders = stored?.ToList() ?? new();

        if (_orders.Any())
        {
            var ids = _orders.Select(x => x.ProductId).ToList();

            var result = await getMultipleProductsHandler.Handle(ids);

            _products = result.products;

            if(_loggedInUserId > 0)
            {
                var getUserResult = await getUserDetailsHandler.Handle(_loggedInUserId);

                _userToCheckout = getUserResult.userDetails;
            }

            _createOrderModel = new CreateOrderDto();
            _createOrderModel.OrderLineItems = _orders;

            if(_userToCheckout is not null)
            {
                _isValidUserDetails = true;
                _createOrderModel.FullName = _userToCheckout.FullName;
                _createOrderModel.PhoneNumber = _userToCheckout.PhoneNumber;
                _createOrderModel.DeliveryAddress = _userToCheckout.Address;
                _createOrderModel.CreatedBy = _userToCheckout.Email;
                _createOrderModel.UserId = _loggedInUserId;
            }
        }

        _isLoading = false;
    }

    private decimal TotalAmount => 
               _products.Join(_orders, x => x.Id, y => y.ProductId, (x, y) => new{ Price = x.SellingPrice, Quantity = y.QuantityOrdered }).Sum(x => x.Price * x.Quantity);

    private async Task RemoveItem(CreateOrderLineItemDto item)
    {
        _orders.Remove(item);
        await localStorageUtility.PersistToStorageAsync(_orders, "orders");
        StateHasChanged();
    }

    private async Task PlaceOrder()
    {

        _isPlacingOrder = true;

        // await Task.Delay(5000);
        // _isSuccessful = DateTime.Now.Second % 2 == 0;
        // _responseMessage = _isSuccessful ? "Order Placed Successfully." : "Order could not be placed";

        var result = await addOrderHandler.Handle(_createOrderModel);
        _isSuccessful = result.isSuccessul; _responseMessage = result.responseMessage;

        if (_isSuccessful)
        {

            await localStorageUtility.RemoveItemFromStorageAsync("orders");
            //_orders.Clear();

            _responseMessage = string.Concat(_responseMessage, "Kindly proceed to confirm your order via email sent to the provided email address.");

            _ = Task.Run(async () =>
            {
                await Task.Delay(7500);
                navigationManager.NavigateTo("/");
            });
        }



        _isPlacingOrder = false;
    }
}
