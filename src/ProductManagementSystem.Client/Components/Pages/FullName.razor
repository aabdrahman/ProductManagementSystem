@using System.Diagnostics.CodeAnalysis

@inherits InputBase<string>


<div class="full-name-group">
    
    <div class="form-group">
        <label>First Name</label>
        <input type="text" value="@_firstName" @onchange="OnChangeFirstName" />
        @if (string.IsNullOrEmpty(_firstName))
        {
            <span class="validation-message">First Name is required.</span>
        }
    </div>

    <div class="form-group">
        <label>Last Name</label>
        <input type="text" value="@_lastName" @onchange="OnChangeLastName" />
        @if(string.IsNullOrEmpty(_lastName))
        {
            <span class="validation-message">Last Name is required.</span>
        }
    </div>

</div>


@code {

    private string _firstName = string.Empty;
    private string _lastName = string.Empty;

