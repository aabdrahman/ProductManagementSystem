    //         SetCurrentValue();
    //     }
    // }

    private void OnChangeFirstName(ChangeEventArgs args)
    {
        _firstName = args?.Value?.ToString() ?? string.Empty;
        SetCurrentValue();
    }

    private void OnChangeLastName(ChangeEventArgs args)
    {
        _lastName = args?.Value?.ToString() ?? string.Empty;
        SetCurrentValue();
    }

    private void SetCurrentValue()
    {
        CurrentValue = string.Join(" ", new[] { _firstName, _lastName }.Where(s => !string.IsNullOrWhiteSpace(s)));
    }

    protected override bool TryParseValueFromString(string value, [MaybeNullWhen(false)] out string result, [NotNullWhen(false)] out string validationErrorMessage)
    {
        throw new NotImplementedException();
    }
}
