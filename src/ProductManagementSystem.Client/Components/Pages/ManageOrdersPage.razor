
@page "/orders"

@rendermode InteractiveServer

@inject GetOrdersHandler getOrdersHandler

<section>

    <div class="management-header">
        <h2>Order Management</h2>

        <p>Track, manage, and process customer orders.</p>

        <div></div>
    </div>

    @if (_isLoading)
    {
        <p>Loading orders...</p>
    }
    else
    {
        if (!_orders.Any())
        {
            <div class="no-orders">
                <h3>No orders yet</h3>
                <p>Orders placed by customers will appear here.</p>
            </div>
        }
        else
        {
            <OrdersListView Orders="_orders" HandleViewOrder="OnHandleView" />

        }
    }
 

</section>


<Popup @ref="popup" Title="@_title" ShowCloseButton="@_showCloseButton" >
    <Body>
        @if(_operationToPerform == OperationType.ViewOrder)
        {
            <OrderDetail OrderToView="@_selectedOrder" />
        }
    </Body>
</Popup>


@code {

    private bool _isLoading;
    private IEnumerable<OrderDto> _orders;
    private string _responseMessage;

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;

        await Task.Delay(250);
        var result = await getOrdersHandler.Handle();
        _orders = result.orders;_responseMessage = result.responseMessage;

        _isLoading = false;
    }
}

@code{
    private string _title;
    private bool _showCloseButton = false;
    private OperationType _operationToPerform;
    private OrderDto _selectedOrder;
    private Popup popup;


    private async Task OnHandleView(OrderDto selectedOrder)
    {
        _selectedOrder = selectedOrder;
        _title = $"Order Details For {_selectedOrder.OrderNumber}";
        _operationToPerform = OperationType.ViewOrder;
        _showCloseButton = true;

        popup.OpenModal();
    }

    enum OperationType
    {
        None,
        ViewOrder
    }
}
