@using ProductManagementSystem.Client.Components.SharedContent

@inject GetProductsHandler getProductsHandler
@inject AddReviewHandler addReviewHandler

@rendermode InteractiveServer

<section id="add-review" class="add-review">

    <div class="add-review-header">
        <h2>Leave a Review</h2>
        <p>Share your experience with this product.</p>
    </div>

    @if(_createReviewModel is not null)
    {
        <EditForm Model="_createReviewModel" FormName="add-review" OnValidSubmit="HandleValidSubmit">
            <DataAnnotationsValidator />

            @if (_products is not null && _products.Any())
            {
                <div class="form-group">
                    <label>Product</label>
                    <InputSelect @bind-Value="_createReviewModel.ProductName">
                        <option value="" selected>Select product to review</option>
                        @foreach (var product in _products)
                        {
                            <option value="@product.Name">@product.Name</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => _createReviewModel.ProductName)" />
                </div>
            }

            <div class="form-group">
                <label>Name</label>
                <InputText @bind-Value="_createReviewModel.ReviewerName" placeholder="Your Name" class="form-control" />
                <ValidationMessage For="@(() => _createReviewModel.ReviewerName)" />
            </div>

            <div class="form-group">
                <label>Your Review</label>
                <InputTextArea @bind-Value="_createReviewModel.Review" placeholder="Write your review..." class="form-control" rows="5" />
                <ValidationMessage For="(() => _createReviewModel.Review)" />
            </div>

            <div class="form-group">
                <label>Rating</label>
                <InputSelect @bind-Value="_createReviewModel.Rating" class="form-control">
                    <option value="0" selected>Select Review Rating</option>
                    <option value="5">5 - Excellent</option>
                    <option value="4">4 - Good</option>
                    <option value="3">3 - Average</option>
                    <option value="2">2 - Poor</option>
                    <option value="1">1 - Terrible</option>
                </InputSelect>
                <ValidationMessage For="@(() => _createReviewModel.Rating)" />
            </div>

            @if(_responseMessage is not null)
            {
                <Status StatusMessage="@_responseMessage" SuccessStatus="@_isSuccessful" />
            }

            <div class="form-button-group">
                <button class="btn cancel" disabled="@_isProcessing" @onclick="Clear" type="button">Cancel Review</button>
                <button class="btn submit" disabled="@_isProcessing" type="submit">
                    @(_isProcessing ? "Submitting Review" : "Submit Review")
                </button>
            </div>

        </EditForm>
    }

</section>

