@code {

    private CreateReviewDto _createReviewModel;

    private List<ProductDto> _products;

    private bool _isSuccessful;
    private string _responseMessage;
    private bool _isProcessing = false;

    private string _title;
    private Popup popup;


    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(500);

        var getProductsResponse = await getProductsHandler.Handle();
        _products = getProductsResponse.products.ToList();

        _createReviewModel = new CreateReviewDto();
    }



    private async Task HandleValidSubmit()
    {
        _isProcessing = true; _responseMessage = null;

        var response = await addReviewHandler.Handle(_createReviewModel);
        _isSuccessful = response.isSuccessful; _responseMessage = response.message;

        //_title = "Review Notification";

        // await Task.Delay(5000);
        // _isSuccessful = DateTime.Now.Second % 2 == 0;
        // _responseMessage = _isSuccessful ? "Review submitted successfully!" : "Failed to submit review.";

        // popup.OpenModal();

        if (_isSuccessful)
        {
            _ = Task.Run(async () =>
            {
                await Task.Delay(5000);
                _responseMessage = null;
                _isSuccessful = default;

                var getProductsResponse = await getProductsHandler.Handle();
                _products = getProductsResponse.products.ToList();

                _createReviewModel = new CreateReviewDto();

                await InvokeAsync(StateHasChanged);
            });
        }

        _isProcessing = false;
    }

    private async Task Clear()
    {

        var getProductsResponse = await getProductsHandler.Handle();
        _products = getProductsResponse.products.ToList();

        _createReviewModel = new CreateReviewDto();
    }
}