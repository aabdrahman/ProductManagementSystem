
@rendermode InteractiveServer

<header class="site-header">
    <div class="header-container">

        <!-- Logo / Site Name -->
        <div class="logo">
            <a href="#">MANAGE X</a>
        </div>

        <!-- Navigation Links -->
        <nav class="nav-links">
            <a href="#products">Products</a>
            <a href="#about-us">About Us</a>
            <a href="#reviews">Reviews</a>
            <a href="/contact-us">Contact</a>
            <a href="/products/manage">Manage Products</a>
        </nav>

        <!-- CTA Button -->
        <div class="header-cta">
            <a href="#products" class="cta-btn">Order Now</a>
        </div>

        <div class="header-actions">
            <a href="/login" class="login-link">Login</a>
            <a href="/checkout" class="checkout-btn">
                🛒 Checkout
                @if (_cartCount > 0)
                {
                    <span class="checkout-badge">@_cartCount</span>
                }
            </a>
        </div>

        <!-- Mobile Menu Icon -->
        <div class="menu-toggle" id="menu-toggle">
            ☰
        </div>

    </div>
</header>



@code {

    private int _cartCount = 0;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var savedOrders = await localStorageUtility
            .GetItemFromStorageAsync<IEnumerable<CreateOrderDto>>("orders");


        _cartCount = savedOrders?.Count() ?? 0;

        StateHasChanged();
    }
}
